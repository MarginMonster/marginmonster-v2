{
  "include": ["env.d.ts", "**/*.ts", "**/*.tsx"],
  // Tests run on node --test, which strips types itself and resolves ESM, so
  // they import with explicit .ts extensions. The app build has no reason to
  // typecheck them and would reject that extension.
  "exclude": ["tests"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["@remix-run/node", "vite/client"],
    // post-title.ts carries an explicit .ts extension so node --test can load
    // it directly (see tests/post-title.test.ts). Vite resolves it natively and
    // tsc only ever runs here with --noEmit, which is what this flag requires.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "target": "ES2022",
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "paths": {
      "~/*": ["./app/*"]
    }
  }
}
